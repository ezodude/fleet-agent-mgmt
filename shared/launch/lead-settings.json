{
  "_comment": "Hooks for lead-1, on the launch line as --settings (agent-up.sh), like ic-settings.json for ICs. A .claude/settings.json at the AgentMgmt root was not loaded by a session whose cwd is Leads/lead-1 (2026-09-15 07:14 relaunch, no marker dir). The scripts exit 0 unless cwd is the lead-1 roster row. Skill enforcement: both roles, IC first, on the owner's word.",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "bashEditDiffEnabled": false,
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$FLEET_REPO/shared/hooks/skill-boot.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$FLEET_REPO/shared/hooks/skill-mark.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$FLEET_REPO/shared/hooks/artefact-gate.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$FLEET_REPO/shared/hooks/stop-skill-gate.sh\""
          }
        ]
      }
    ]
  }
}
