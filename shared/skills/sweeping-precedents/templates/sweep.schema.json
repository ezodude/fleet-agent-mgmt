{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sweep.schema.json",
  "title": "precedents sweep",
  "description": "The record's precedents.json: the haiku agent's reply, saved by the lead, and the lead's pick after it. Either the none form, for a project whose gatherer printed `none: no close report for <project>`, or the rows form: every row the gatherer printed, once, in one P row's sources or in not_carried. A superseded row goes in not_carried. shared/records/precedents_check.py reads this file as the statement of shape.",
  "oneOf": [
    { "$ref": "#/$defs/none" },
    { "$ref": "#/$defs/sweep" }
  ],
  "$defs": {
    "line": {
      "type": "string",
      "pattern": "^[^\\n]*\\S[^\\n]*$"
    },
    "reference": {
      "description": "A row's reference exactly as the gatherer prints it: <record> · <section> · row <n>.",
      "type": "string",
      "pattern": "^\\S+ · (CHANGED|LEARNED|OWED) · row [1-9][0-9]*$"
    },
    "none": {
      "type": "object",
      "required": ["none"],
      "additionalProperties": false,
      "properties": {
        "none": { "$ref": "#/$defs/line" }
      }
    },
    "sweep": {
      "type": "object",
      "required": ["project", "rows_read", "records", "rows", "not_carried"],
      "additionalProperties": false,
      "properties": {
        "project": { "$ref": "#/$defs/line" },
        "rows_read": { "type": "integer", "minimum": 0 },
        "records": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/line" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/row" }
        },
        "not_carried": {
          "type": "array",
          "items": { "$ref": "#/$defs/not_carried" }
        }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "rule", "sources", "fits", "why", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^P[1-9][0-9]*$" },
        "rule": { "$ref": "#/$defs/line", "maxLength": 300 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        },
        "owner_quote": { "$ref": "#/$defs/line" },
        "fits": { "enum": ["constraint", "gate pass line", "one-way", "open"] },
        "why": { "$ref": "#/$defs/line", "maxLength": 300 },
        "status": {
          "type": "string",
          "pattern": "^(live|stale-after \\S[^\\n]*)$"
        }
      }
    },
    "not_carried": {
      "type": "object",
      "required": ["reference", "reason"],
      "additionalProperties": false,
      "properties": {
        "reference": { "$ref": "#/$defs/reference" },
        "reason": { "$ref": "#/$defs/line", "maxLength": 300 }
      }
    }
  }
}
